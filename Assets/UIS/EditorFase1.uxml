<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UIS/sfdddfsdfsdsfsddfs.uss?fileID=7433441132597879392&amp;guid=c4436d509f060744e8655647c860f26f&amp;type=3#sfdddfsdfsdsfsddfs" />
    <engine:ScrollView style="width: 35%; background-color: rgb(200, 200, 200); min-width: auto; min-height: 100%; max-height: 100%; border-left-color: rgb(159, 159, 159); border-right-color: rgb(111, 111, 111); border-top-color: rgb(168, 168, 168); border-bottom-color: rgb(63, 63, 63); border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; flex-grow: 1;">
        <engine:Foldout text="Tools" name="Tool-Foldout" value="true" class="Tool" style="max-width: 98%; border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-top-left-radius: 2px; border-top-right-radius: 2px; border-bottom-right-radius: 2px; border-bottom-left-radius: 2px; border-right-color: rgba(123, 0, 0, 0.82); border-bottom-color: rgb(77, 34, 34); left: 1%;">
            <engine:RadioButtonGroup label="Herramienta elegida" choices="Mover,Girar,Rotar" name="SlctT" />
        </engine:Foldout>
        <engine:Foldout text="Microbe Parts" value="true" name="Foldout" class="aaaaa" style="margin-top: 3px; margin-right: 3px; margin-bottom: 3px; margin-left: 3px; border-left-color: rgb(180, 180, 180); border-top-color: rgb(217, 217, 217); border-right-color: rgb(130, 130, 130);">
            <engine:Button text="Eye" name="eye" tooltip="AAAA" class="PBu" />
            <engine:Button text="Herbivore mouth" name="MouthH" class="PBu" />
            <engine:Button text="Carnivore mouth" name="MouthC" class="PBu" />
            <engine:Button text="Omnivore mouth" name="MouthO" class="PBu" />
            <engine:Button text="Spike" name="Spike" class="PBu" />
            <engine:Button text="flagela" name="flagela" class="PBu" />
            <engine:Button text="poison shooter" name="Posion" class="PBu" />
            <engine:Button text="Electricity" name="Shock" class="PBu yellow" />
        </engine:Foldout>
        <engine:Foldout text="Painting" name="Paint-Foldout" value="true" class="Paint" style="max-width: 98%; border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-top-left-radius: 2px; border-top-right-radius: 2px; border-bottom-right-radius: 2px; border-bottom-left-radius: 2px; border-right-color: rgba(0, 123, 119, 0.82); border-bottom-color: rgb(34, 75, 77); left: 1%;">
            <engine:SliderInt label="R" value="0" high-value="255" name="R" class="aaaaaadssad R" style="max-width: 92%; height: 24px;" />
            <engine:SliderInt label="G" value="0" high-value="255" focusable="true" name="G" style="max-width: 92%; -unity-background-image-tint-color: rgb(255, 255, 255); border-left-color: rgba(0, 0, 0, 0); border-right-color: rgba(0, 0, 0, 0); border-top-color: rgba(0, 0, 0, 0); border-bottom-color: rgba(0, 0, 0, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; height: 22px;" />
            <engine:SliderInt label="B" value="0" high-value="255" focusable="true" name="B" style="min-width: auto; max-width: 92%; height: 30px;" />
            <engine:Button text="preview" name="Prev" style="height: 75px; width: 80px; align-self: auto; flex-direction: row; background-color: rgb(255, 255, 255);" />
            <engine:Button text="apply" name="ApplyPaint" class="Paint PaintButton" style="height: 31px; width: 93px; flex-direction: row; flex-wrap: wrap; position: absolute; top: 130px; left: 94px;" />
        </engine:Foldout>
    </engine:ScrollView>
    <engine:Button text="Sig" name="Sig" class="text-auto-size text-auto-size-min-12-50 text-auto-size-max-999 PBu" style="width: 12%; height: 11%; position: absolute; right: 13%; bottom: 4%;" />
    <engine:Button text="Atras" name="Atrs" class="text-auto-size text-auto-size-min-12-50 text-auto-size-max-999 PBu" style="width: 12%; height: 11%; position: absolute; right: 30%; bottom: 4%;" />
    <engine:ScrollView style="top: auto; right: 0; position: absolute; width: 27%; border-right-color: rgb(111, 111, 111); flex-direction: row-reverse; align-self: center; background-color: rgb(200, 200, 200); min-height: auto; border-bottom-color: rgb(63, 63, 63); border-left-color: rgb(159, 159, 159); border-top-color: rgb(168, 168, 168); border-top-width: 3px; border-right-width: 3px; border-bottom-width: 3px; border-left-width: 3px; align-items: stretch; flex-wrap: wrap; min-width: auto; max-height: 66%; flex-grow: 1;">
        <engine:Label text="Editando El Genero" name="Edt" />
        <engine:Button name="SRX" focusable="true" class="PBu" style="top: auto; right: auto; position: relative; background-image: none; width: 30%; height: 11%; display: flex; visibility: visible; opacity: 1;" />
        <engine:Foldout text="Reproduccion" value="true" class="aaaaa">
            <engine:Label text="Tipo" />
            <engine:EnumField type="SerializableTypes.Biology.reproductionTypes, Assembly-CSharp" name="ASE" style="max-width: none; min-width: 120px;" />
            <engine:Label text="Metodo" />
            <engine:EnumField value="Mitosis" type="SerializableTypes.ReproductionMethod, Assembly-CSharp" name="MTD" style="max-width: none; min-width: 120px;" />
            <engine:Label text="¿Hay diferencia de género biológico?" />
            <engine:Toggle name="DIM" style="flex-shrink: 1; flex-grow: 1; max-width: 27%; max-height: 27%;" />
        </engine:Foldout>
        <engine:Label name="WARNING" class="text-auto-size text-auto-size-min-0" style="-unity-text-outline-width: 1px; -unity-text-outline-color: rgb(33, 4, 67); color: rgb(255, 0, 0); font-size: 28px; min-height: initial; min-width: initial; text-overflow: clip; white-space: normal; flex-shrink: 1; flex-grow: 0; visibility: visible; display: flex; max-height: 20%;" />
    </engine:ScrollView>
    <engine:SliderInt label="SliderInt" value="42" high-value="100" />
</engine:UXML>
