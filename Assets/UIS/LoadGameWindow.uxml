<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <engine:VisualElement name="WindowRoot" style="flex-grow: 1; background-color: rgba(172, 225, 238, 0.66); width: 50%; height: 50%; top: 25%; align-self: center; max-height: 55%; min-height: 50%;">
        <engine:Label text="Cargar Partida" name="Tituylo" class="text-auto-size text-auto-size-max-9999" style="background-color: rgba(0, 220, 255, 0.69); border-left-color: rgb(0, 220, 255); border-right-color: rgb(0, 220, 255); border-top-color: rgb(0, 220, 255); border-bottom-color: rgb(0, 220, 255); border-top-left-radius: 1px; border-top-right-radius: 1px; border-bottom-right-radius: 1px; border-bottom-left-radius: 1px; border-top-width: 3px; border-right-width: 3px; border-bottom-width: 3px; border-left-width: 3px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; height: 7%; width: 100%;" />
        <engine:Button text="X" name="Close" class="text-auto-size text-auto-size-max-99999" style="position: absolute; right: 0; top: 0; height: 7%; width: 9%; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; background-color: rgba(255, 0, 0, 0.8); color: rgb(255, 255, 255);" />
        <engine:ScrollView name="Window_Cnt" style="min-width: 100%; min-height: 87%; background-color: rgba(178, 53, 53, 0); right: auto; bottom: auto; left: auto; top: 4%; align-self: center; justify-content: flex-start; max-width: 100%; max-height: 69%;" />
    </engine:VisualElement>
</engine:UXML>
