<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <engine:VisualElement style="flex-grow: 0; background-color: rgb(150, 150, 150); width: 76%; left: 11%; height: 65%; flex-shrink: 0; top: 22%;">
        <engine:Label text="#ENDCELL" style="white-space: normal; background-color: rgb(201, 244, 255); border-left-color: rgb(61, 66, 255); border-right-color: rgb(61, 66, 255); border-top-color: rgb(61, 66, 255); border-bottom-color: rgb(61, 66, 255); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;" />
        <engine:Label text="#ENDCELLMSG" style="white-space: normal;" />
        <engine:ScrollView>
            <engine:Label text="#credits" style="white-space: normal;" />
        </engine:ScrollView>
        <engine:Button text="OK" name="OK" style="bottom: initial;" />
    </engine:VisualElement>
</engine:UXML>
